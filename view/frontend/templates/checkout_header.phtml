<?php
$cartUrl = $block->getUrl('checkout/cart');
/** @var \Panth\CheckoutExtended\ViewModel\CheckoutLogo|null $logoViewModel */
$logoViewModel = $block->getData('logo_view_model');
$logo = $logoViewModel ? $logoViewModel->getLogo($block->getChildBlock('logo')) : null;
?>
<div class="panth-checkout-header">
    <a href="<?= $block->escapeUrl($cartUrl) ?>" class="panth-back-to-store panth-checkout-header__back">
        <svg class="panth-checkout-header__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <span class="panth-checkout-header__back-text"><?= $block->escapeHtml(__('Back to Cart')) ?></span>
    </a>
    <div class="panth-checkout-header__logo">
        <?php if ($logo): ?>
            <a class="logo" href="<?= $block->escapeUrl($logoViewModel->getHomeUrl()) ?>" title="<?= $block->escapeHtmlAttr($logo['alt']) ?>">
                <img src="<?= $block->escapeUrl($logo['src']) ?>"
                     alt="<?= $block->escapeHtmlAttr($logo['alt']) ?>"
                     <?php if ($logo['width'] > 0): ?>width="<?= (int) $logo['width'] ?>"<?php endif; ?>
                     <?php if ($logo['height'] > 0): ?>height="<?= (int) $logo['height'] ?>"<?php endif; ?>
                     loading="eager" />
            </a>
        <?php else: ?>
            <?= $block->getChildHtml('logo') ?>
        <?php endif; ?>
    </div>
    <span class="panth-checkout-header__secure">
        <svg class="panth-checkout-header__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="panth-checkout-header__secure-text"><?= $block->escapeHtml(__('Secure checkout')) ?></span>
    </span>
</div>
